MONGODB_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace-with-a-long-random-string
PORT=4000

# Browser origin allowed to send credentialed requests. Required in local dev
# because the Vite client runs on a different port from the API.
CLIENT_ORIGIN=http://localhost:5173

# OAuth sign-in. Leave a provider's id and secret empty to disable that provider.
OAUTH_CALLBACK_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub App repository connection (separate from GitHub sign-in).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_REDIRECT_URI=http://localhost:4000/api/github/callback
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/absolute/private/path/github-app.pem
GITHUB_WEBHOOK_SECRET=
